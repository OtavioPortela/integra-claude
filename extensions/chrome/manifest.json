{
  "manifest_version": 3,
  "name": "Integra Claude",
  "version": "0.1.1",
  "description": "Liga suas conversas do ChatGPT ao app Integra Claude (local, no seu Mac).",
  "key": "",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Integra Claude" }
}
